          "id": "n6_gift_flour",
          "itemTag": "baking",
          "text": {
            "tr": "Un taze… fırın mutlu. Sen de mutlu ol.",
            "en": "Flour's fresh… the oven's happy. You should be too."
          },
          "affinityDelta": 2
        },
        {
          "id": "n6_gift_jam",
          "itemTag": "jam",
          "text": {
            "tr": "Reçel mi? Poğaçaya süreceğim, mahalle bayılacak.",
            "en": "Jam? Going on the buns—the block will melt."
          },
          "affinityDelta": 1
        }
      ],
      "talkLines": [
        {
          "id": "n6_talk_oven",
          "text": {
            "tr": "Sıcak tepsi, soğuk sinirleri eritir. Arenada da öyle.",
            "en": "A warm tray melts cold nerves. Same in the arena."
          }
        },
        {
          "id": "n6_talk_care",
          "text": {
            "tr": "Kim düşerse onu kaldırırsın. Ben poğaçayla kaldırırsın.",
            "en": "Whoever falls, you pick them up. I pick them up with buns."
          }
        }
      ],
      "drama": {
        "id": "n6_drama_batch",
        "prompt": {
          "tr": "Can'ın poğaçası yetmez. Önce kupacılar mı, yoksa bütün sokak mı?",
          "en": "Can's batch is short. Cup team first—or the whole street?"
        },
        "choices": [
          {
            "id": "n6_c_team",
            "label": {
              "tr": "Kupacıya öncelik",
              "en": "Prioritize Cup team"
            },
            "traitDeltas": {
              "Rival": 1,
              "Soft": -1
            },
            "affinityDelta": 1
          },
          {
            "id": "n6_c_street",
            "label": {
              "tr": "Herkese bölüştür",
              "en": "Share with everyone"
            },
            "traitDeltas": {
              "Soft": 2,
              "Gossip": 1
            },
            "affinityDelta": 2
          }
        ]
      }
    }
