          "itemTag": "audio",
          "text": {
            "tr": "Bu kulaklıkla bas duvara yapışır. Neon yanıyor.",
            "en": "With these cans the bass sticks to the wall. Neon's lit."
          },
          "affinityDelta": 2
        },
        {
          "id": "n5_gift_energy",
          "itemTag": "energy",
          "text": {
            "tr": "Gece seti için yakıt. Teşekkürler, komşu.",
            "en": "Fuel for the night set. Thanks, neighbor."
          },
          "affinityDelta": 1
        }
      ],
      "talkLines": [
        {
          "id": "n5_talk_set",
          "text": {
            "tr": "İlk sekiz saniye kritik. Sonra herkes dans eder—ya da kaçar.",
            "en": "First eight seconds matter. Then everyone dances—or runs."
          }
        },
        {
          "id": "n5_talk_street",
          "text": {
            "tr": "Sokak lambası yetmez. Neon lazım, minik arena lazım.",
            "en": "Street lamps aren't enough. Need neon, need a tiny stage."
          }
        }
      ],
      "drama": {
        "id": "n5_drama_volume",
        "prompt": {
          "tr": "Peri'nin seti yüksek. Mahalle mi kazanır, yoksa beat mi?",
          "en": "Peri's set is loud. Does the block win—or the beat?"
        },
        "choices": [
          {
            "id": "n5_c_blast",
            "label": {
              "tr": "Sesi aç, neon yak",
              "en": "Crank it, light neon"
            },
            "traitDeltas": {
              "Nightowl": 2,
              "Chaos": 1
            },
            "affinityDelta": 1
          },
          {
            "id": "n5_c_quiet",
            "label": {
              "tr": "Kulaklığa geç",
              "en": "Switch to headphones"
            },
            "traitDeltas": {
              "Nightowl": -1,
              "Soft": 1,
              "Grumpy": -1
            },
            "affinityDelta": 2
          }
        ]
      }
    },
