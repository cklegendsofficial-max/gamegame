      "id": "n1",
      "nameKey": "neighbor.n1.name",
      "name": {
        "tr": "Merve Teyze",
        "en": "Aunt Merve"
      },
      "trait": "Gossip",
      "role": "Support buffer",
      "synergyTag": "Tea",
      "prop": {
        "id": "prop_demlik",
        "nameKey": "prop.demlik",
        "label": {
          "tr": "Demlik",
          "en": "Teapot"
        }
      },
      "bustAssetHint": "bust_aunt_merve",
      "giftLines": [
        {
          "id": "n1_gift_tea",
          "itemTag": "tea",
          "text": {
            "tr": "Ay canım, demliği tazeledin! Mahalle bunları konuşacak.",
            "en": "Oh sweetie, you topped up the pot! The street will talk about this."
          },
          "affinityDelta": 2
        },
        {
          "id": "n1_gift_gossip",
          "itemTag": "pastry",
          "text": {
            "tr": "Bu börekle üç kapı birden yumuşar. Anlattırırım hepsini.",
            "en": "This pastry softens three doors at once. I'll get every story."
          },
          "affinityDelta": 1
        }
      ],
      "talkLines": [
        {
          "id": "n1_talk_porch",
          "text": {
            "tr": "Dün gece 3. kattakiler yine geç yattı. Ben sadece çay demliyorum tabii.",
            "en": "Third floor stayed up late again. Me? Just brewing tea, of course."
          }
        },
        {
          "id": "n1_talk_cup",
          "text": {
            "tr": "Kupada kim kimle yan yana? Söyle, ben zaten biliyorum gibi.",
            "en": "Who's next to who in the Cup? Tell me—I already almost know."
          }
        }
      ],
      "drama": {
        "id": "n1_drama_whisper",
        "prompt": {
          "tr": "Merve Teyze, komşu kavgasını herkese mi anlatsın, yoksa arabulucu mu olsun?",
          "en": "Should Aunt Merve broadcast the neighbor spat—or mediate quietly?"
        },
        "choices": [
          {
            "id": "n1_c_spread",
            "label": {
              "tr": "Herkese fısılda",
              "en": "Whisper it around"
            },
            "traitDeltas": {
              "Gossip": 2,
              "Soft": -1
            },
            "affinityDelta": 1
          },
          {
            "id": "n1_c_mediate",
            "label": {
              "tr": "Arabuluculuk yap",
              "en": "Mediate instead"
            },
            "traitDeltas": {
              "Gossip": -1,
              "Soft": 2
            },
            "affinityDelta": 2
          }
        ]
      }
    },
    {
      "id": "n2",
      "nameKey": "neighbor.n2.name",
      "name": {
        "tr": "Antrenör Cem",
        "en": "Coach Cem"
      },
      "trait": "Rival",
      "role": "Bruiser",
      "synergyTag": "Rivalry",
      "prop": {
        "id": "prop_duduk",
        "nameKey": "prop.duduk",
        "label": {
          "tr": "Düdük",
          "en": "Whistle"
        }
      },
      "bustAssetHint": "bust_coach_cem",
      "giftLines": [
        {
          "id": "n2_gift_whistle",
          "itemTag": "sport",
          "text": {
            "tr": "Bu düdükle rakipler titrer. İyi hamle.",
            "en": "With this whistle, rivals flinch. Solid move."
          },
          "affinityDelta": 2
        },
        {
          "id": "n2_gift_snack",
          "itemTag": "protein",
          "text": {
            "tr": "Enerji barı? Antrenman sonrası şart. Teşekkürler şampiyon.",
            "en": "Energy bar? Post-drill essential. Thanks, champ."
          },
          "affinityDelta": 1
        }
      ],
      "talkLines": [
        {
          "id": "n2_talk_drill",
          "text": {
            "tr": "Porch Cup'ta kimse ısınmadan girmesin. Ben ısındırırım.",
            "en": "Nobody enters Porch Cup cold. I'll warm them up."
          }
        },
        {
          "id": "n2_talk_rival",
          "text": {
            "tr": "Rakip zayıfsa zafer tatsız. Bana gerçek bir düello lazım.",
            "en": "Easy rivals taste empty. I need a real duel."
          }
        }
      ],
      "drama": {
        "id": "n2_drama_score",
        "prompt": {
          "tr": "Cem, gençleri sert mi çalıştırsın, yoksa moral için mi gevşetsin?",
          "en": "Should Cem push the kids hard—or ease up for morale?"
        },
        "choices": [
          {
            "id": "n2_c_push",
            "label": {
              "tr": "Sert antrenman",
              "en": "Hard drills"
            },
            "traitDeltas": {
              "Rival": 2,
              "Chaos": 1
            },
            "affinityDelta": 1
          },
          {
            "id": "n2_c_ease",
            "label": {
              "tr": "Moral molası",
              "en": "Morale break"
            },
            "traitDeltas": {
              "Rival": -1,
              "Soft": 2
            },
            "affinityDelta": 2
          }
        ]
      }
    },
    {
      "id": "n3",
      "nameKey": "neighbor.n3.name",
      "name": {
        "tr": "Çocuk Leyla",
        "en": "Kid Leyla"
      },
      "trait": "Chaos",
      "role": "Glass cannon",
      "synergyTag": "Chaos",
      "prop": {
        "id": "prop_ucurtma",
        "nameKey": "prop.ucurtma",
        "label": {
          "tr": "Uçurtma",
          "en": "Kite"
        }
      },
      "bustAssetHint": "bust_kid_leyla",
      "giftLines": [
        {
          "id": "n3_gift_kite",
          "itemTag": "toy",
          "text": {
            "tr": "Yeni uçurtma!! Rüzgârı mahalleye çağırıyorum!",
            "en": "New kite!! I'm summoning the wind for the whole block!"
          },
          "affinityDelta": 2
        },
        {
          "id": "n3_gift_candy",
          "itemTag": "candy",
          "text": {
            "tr": "Şeker mi? Ben zaten hızlıydım… şimdi daha hızlıyım.",
            "en": "Candy? I was already fast… now I'm faster."
          },
          "affinityDelta": 1
        }
      ],
      "talkLines": [
        {
          "id": "n3_talk_rooftop",
          "text": {
            "tr": "Çatıdan bakınca herkes minik! Arena da öyle olmalı.",
            "en": "From the roof everyone looks tiny! The arena should too."
          }
        },
        {
          "id": "n3_talk_chaos",
          "text": {
            "tr": "Plan mı? Plan, plandır… ta ki uçurtma takılana kadar.",
            "en": "A plan? Plans are plans… until the kite snags."
          }
        }
      ],
      "drama": {
        "id": "n3_drama_kite",
        "prompt": {
          "tr": "Leyla'nın uçurtması Orhan Amca'nın antenine dolaştı. Ne yapalım?",
          "en": "Leyla's kite tangled in Mr. Orhan's antenna. What now?"
        },
        "choices": [
          {
            "id": "n3_c_dare",
            "label": {
              "tr": "Daha yükseğe çık",
              "en": "Climb higher"
            },
            "traitDeltas": {
              "Chaos": 2,
              "Grumpy": 1
            },
            "affinityDelta": 1
          },
          {
            "id": "n3_c_apologize",
            "label": {
              "tr": "Özür dile, yardım et",
              "en": "Apologize and help"
            },
            "traitDeltas": {
              "Chaos": -1,
              "Soft": 2
            },
            "affinityDelta": 2
          }
        ]
      }
    },
    {
      "id": "n4",
      "nameKey": "neighbor.n4.name",
      "name": {
        "tr": "Orhan Amca",
        "en": "Mr. Orhan"
      },
      "trait": "Grumpy",
      "role": "Tank",
      "synergyTag": "Fence",
      "prop": {
        "id": "prop_gazete",
        "nameKey": "prop.gazete",
        "label": {
          "tr": "Gazete",
          "en": "Newspaper"
        }
      },
      "bustAssetHint": "bust_mr_orhan",
      "giftLines": [
        {
          "id": "n4_gift_paper",
          "itemTag": "newspaper",
          "text": {
            "tr": "Hım. Sayfalar düzgün katlanmış. Nadir şey.",
            "en": "Hmph. Pages folded properly. Rare these days."
          },
          "affinityDelta": 2
        },
        {
          "id": "n4_gift_tea",
          "itemTag": "tea",
          "text": {
            "tr": "Çay… kabul. Konuşma kısmını kısa tut.",
            "en": "Tea… accepted. Keep the talking short."
          },
          "affinityDelta": 1
        }
      ],
      "talkLines": [
        {
          "id": "n4_talk_fence",
          "text": {
            "tr": "Çit sağlamsa mahalle sağlamdır. Gerisi gürültü.",
            "en": "If the fence holds, the block holds. The rest is noise."
          }
        },
        {
          "id": "n4_talk_cup",
          "text": {
            "tr": "Kupada ön safta dururum. Geri çekilmem.",
            "en": "I'll stand front line in the Cup. I don't step back."
          }
        }
      ],
      "drama": {
        "id": "n4_drama_noise",
        "prompt": {
          "tr": "Gece gürültüsü Orhan Amca'yı uyandırdı. Ne önerirsin?",
          "en": "Night noise woke Mr. Orhan. What's your call?"
        },
        "choices": [
          {
            "id": "n4_c_scold",
            "label": {
              "tr": "Kapıya çık, azarla",
              "en": "Scold at the door"
            },
            "traitDeltas": {
              "Grumpy": 2,
              "Nightowl": -1
            },
            "affinityDelta": 1
          },
          {
            "id": "n4_c_earplug",
            "label": {
              "tr": "Kulak tıkaçları + çay",
              "en": "Earplugs and tea"
            },
            "traitDeltas": {
              "Grumpy": -1,
              "Soft": 1,
              "Tea": 1
            },
            "affinityDelta": 2
          }
        ]
      }
    },
