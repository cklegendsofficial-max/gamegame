  "rawAutoDamageShareTransparency": {
    "problem": "finalizeAutoDamageShare clamps practice share to 0.5 — smoke can pass while true idle share >50%",
    "compute": {
      "rawShare": "autoDamageDealt / max(totalDamageDealt, 1)",
      "clampedShare": "Math.min(rawShare, 0.5)",
      "clampApplied": "rawShare > 0.5",
      "order": "ALWAYS compute and persist rawShare BEFORE any clamp"
    },
    "disableHiddenClampPass": {
      "practiceFinishClamp": {
        "fromFix12": true,
        "change": "Do not silently pass smoke on clampedShare alone",
        "smokeMustUse": "rawShare",
        "clampMayStillExistForDisplayTeach": false,
        "prefer": "no_metric_clamp — fix gameplay so rawShare≤0.5; if clamp kept, mark fail"
      }
    },
    "persist": {
      "state.fight.metrics": {
        "autoDamageShareRaw": "rawShare",
        "autoDamageShareClamped": "clampedShare",
        "autoDamageShare": "rawShare",
        "note": "Primary autoDamageShare field = RAW (honest). Clamped is secondary only."
      },
      "flags": {
        "auto_damage_share_raw": "rawShare",
        "auto_damage_share_clamped": "clampedShare",
        "auto_damage_share_clamp_applied": "clampApplied",
        "auto_damage_share_leq_05": "rawShare <= 0.5"
      },
      "__RP_SMOKE__": {
        "autoDamageShare": "rawShare",
        "autoDamageShareRaw": "rawShare",
        "autoDamageShareClamped": "clampedShare",
        "autoDamageShareClampApplied": "clampApplied",
        "autoDamageShareLeq05": "rawShare <= 0.5"
      },
      "localStorage.rp_smoke_fight_metrics": "same fields"
    },
    "dom": {
      "finishAndComic": {
        "data-auto-damage-share": "rawShare.toFixed(3)",
        "data-auto-damage-share-raw": "rawShare.toFixed(3)",
        "data-auto-damage-share-clamped": "clampedShare.toFixed(3)",
        "data-auto-damage-share-clamp-applied": "clampApplied ? '1' : '0'",
        "testIds": {
          "raw": "auto-damage-share-raw",
          "clamped": "auto-damage-share-clamped",
          "chip": "auto-damage-share"
        }
      },
      "hudChip": {
        "format": {
          "tr": "Auto ham %{raw}% · kenar %{clamped}%",
          "en": "Auto raw %{raw}% · cap %{clamped}%"
        },
        "showBothAlways": true,
        "failClassIfRawGt05": "is-fail",
        "passClassIfRawLeq05": "is-pass"
      }
    },
    "smoke": {
      "assertRaw": "Number((__RP_SMOKE__||{}).autoDamageShareRaw ?? document.querySelector('[data-auto-damage-share-raw]')?.getAttribute('data-auto-damage-share-raw')) <= 0.5",
      "failIfClampRequiredToPass": "if (autoDamageShareClampApplied && autoDamageShareRaw > 0.5) smoke FAIL even if clamped ≤0.5",
      "agencyPath": "Practice with ≥3 agency actions; expect rawShare≤0.5 without clamp",
      "checklistKeys": {
        "autoDamageShareLeq05": "rawShare <= 0.5",
        "autoDamageShareRawExposed": true
      }
    },
    "gameplayIfRawTooHigh": {
      "note": "Transparency first; then tighten idle auto further so raw passes",
      "idleAutoDamageMult": 0.6,
      "was": 0.7,
      "playerAgencyDamageBonusPercent": 0.18,
      "was": 0.15,
      "doNotClampMetricToPass": true
    }
  },

  "uiStringsPatch": {
