  "synergyFooterSync": {
    "problem": "Footer can show 0/3 while picks are lit — desync before Start",
    "sourceOfTruth": "draftPickNeighborIds",
    "recompute": {
      "when": [
        "pick_toggle",
        "pick_clear",
        "show_me_autopick",
        "placement_move",
        "locale_change",
        "before_start_enable"
      ],
      "fn": "countMatchingTagsFromPools(draftPickNeighborIds, synergyTagPools)",
      "debounceMs": 0
    },
    "footerModel": {
      "items": [
        {
          "synergyId": "syn_rivalry",
          "displayCount": "{matched}/{minCount}",
          "activeWhen": "matched >= minCount",
          "inactiveLabel": {
            "tr": "Rekabet",
            "en": "Rivalry"
          }
        },
        {
          "synergyId": "syn_tea_circle",
          "displayCount": "{matched}/{minCount}",
          "activeWhen": "matched >= minCount",
          "inactiveLabel": {
            "tr": "Çay Çemberi",
            "en": "Tea Circle"
          }
        },
        {
          "synergyId": "syn_neon_night",
          "displayCount": "{matched}/{minCount}",
          "activeWhen": "matched >= minCount",
          "inactiveLabel": {
            "tr": "Neon Gece",
            "en": "Neon Night"
          }
        }
      ],
      "opposingBotPill": {
        "prefix": {
          "tr": "Bot ·",
          "en": "Bot ·"
        },
        "fromEnemyLineupPools": true,
        "mustMatchEnemyPicks": true
      }
    },
    "syncGuards": {
      "beforeStartAssert": "footer.activeSynergyIds === computeActiveSynergies(draftPickNeighborIds)",
      "onMismatch": {
        "action": "force_recompute_and_rerender",
        "blockStart": true,
        "devWarn": "synergy_footer_desync"
      },
      "highlightPicksThatContribute": true,
      "dimPicksThatDoNotContributeToHoveredPill": true
    },
    "acceptance": {
      "tr": "Start'tan önce footer, seçili komşuların etiket havuzuyla birebir uyumlu.",
      "en": "Before Start, footer matches tag pools of current picks exactly."
    }
  },
