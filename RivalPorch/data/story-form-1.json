  "localeDefault": "tr",
  "purpose": "Make Season 1 main-quest spine obvious in player-facing copy and add 5 arc-reactive dialogues so prior arc flags visibly change later evenings.",
  "sourcePacks": [
    "internal/rival-porch-quests.json",
    "internal/rival-porch-story-content.json",
    "internal/rival-porch-session-density.json"
  ],
  "designDocs": [
    "docs/rival-porch-quest-design.md",
    "docs/rival-porch-story-bible.md",
    "docs/rival-porch-session-density.md"
  ],
  "integrator": {
    "owner": "code owner on cursor/rival-porch-slice-31f7",
    "noPrFromThisPackAuthor": true,
    "mergeMode": "patch-overlay",
    "wire": [
      "Apply mainQuestSpineCopy.questPatches onto data/quests.overlay.json (or store quests pack) title/summary/labels + new spine* fields",
      "Append dialogueTreesAppend to story dialogueTrees; register in quest links / evening rotator via schedule",
      "Merge arcVisibility.journalSpine into Story Journal / HUD spine strip",
      "Append echoFollowUpsAppend into session-density echoes (priority already set)",
      "Honor requiresFlags / requiresFlagsNone on dialogue roots and choice gates"
    ],
    "doNot": [
      "Gate any of these beats behind spend",
      "Replace existing beat dialogues (dlg_kite_*, dlg_volume_*, dlg_tea_*) — these are AFTERSHOCK / CROSS-ARC only",
      "Open a separate PR from story squad"
    ]
  },
  "principles": {
    "storyNeverGatedBySpend": true,
    "softFailsOnly": true,
    "spineMustNameNextQuest": true,
    "arcReactiveMustBranchOnRealFlags": true,
    "oneReactiveSlotPerEveningMax": true
  },
