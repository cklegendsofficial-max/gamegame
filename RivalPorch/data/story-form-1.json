  "dialogueTreesAppend": [
    {
      "id": "dlg_react_kite_aftermath",
      "kind": "arc_reactive",
      "title": {
        "tr": "Bayrak mı, tebeşir mi?",
        "en": "Flag or chalk?"
      },
      "start": "kra_root",
      "reactsToFlagsAny": [
        "flag_fence_and_kite",
        "flag_kite_chaos_buff"
      ],
      "nodes": [
        {
          "id": "kra_root",
          "speaker": "narrator",
          "text": {
            "tr": "Cup 2'den sonra çatı hâlâ konuşuyor. Sokak hangi sonu seçtiğini unutmadı.",
            "en": "After Cup 2 the roof is still talking. The street didn't forget which ending you picked."
          },
          "choices": [
            {
              "id": "kra_peace_door",
              "label": {
                "tr": "Bayrağa bak (barış yolu)",
                "en": "Check the flag (peace path)"
              },
              "next": "kra_peace",
              "requiresFlags": [
                "flag_fence_and_kite"
              ]
            },
            {
              "id": "kra_chaos_door",
              "label": {
                "tr": "Tebeşir oklarına bak (kaos yolu)",
                "en": "Check the chalk arrows (chaos path)"
              },
              "next": "kra_chaos",
              "requiresFlags": [
                "flag_kite_chaos_buff"
              ]
            },
            {
              "id": "kra_ask_merve",
              "label": {
                "tr": "Merve'ye sor — hangisi doğru?",
                "en": "Ask Merve — which version stuck?"
              },
              "next": "kra_merve",
              "affinity": [
                {
                  "id": "n1",
                  "delta": 1
                }
              ],
              "rep": {
                "rep_mediator": 1
              }
            }
          ]
        },
        {
          "id": "kra_peace",
          "speaker": "n4",
          "text": {
            "tr": "Bayrak duruyor. Uçurtma alçaktan geçti bu sabah. …Kabul edilebilir.",
            "en": "Flag's still up. Kite passed low this morning. …Acceptable."
          },
          "setFlags": [
            "react_kite_aftermath_seen",
            "react_kite_peace_ack"
          ],
          "ends": true
        },
        {
          "id": "kra_chaos",
          "speaker": "n3",
          "text": {
            "tr": "Yasak bölge yok artık! Orhan gazetesini daha sert katlıyor ama harita kazanıyor.",
            "en": "No forbidden zone anymore! Orhan folds his paper harder — but the map is winning."
          },
          "setFlags": [
            "react_kite_aftermath_seen",
            "react_kite_chaos_ack"
          ],
          "ends": true
        },
        {
          "id": "kra_merve",
          "speaker": "n1",
          "text": {
            "tr": "İki afiş vardı. Sokak birini seçti — sen seçtirdin. Ben sadece demliği kaynattım.",
            "en": "There were two posters. The street picked one — you made it pick. I just boiled the tea."
          },
          "setFlags": [
            "react_kite_aftermath_seen"
          ],
          "ends": true
        }
      ]
    },
    {
